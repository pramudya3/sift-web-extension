{
  "manifest_version": 3,
  "name": "Sift v0.10.0 (dev)",
  "version": "0.10.0",
  "description": "Close your tabs. Keep your research.",
  "minimum_chrome_version": "114",
  "permissions": ["tabs", "storage", "sidePanel", "tabGroups"],
  "background": { "service_worker": "background.js", "type": "module" },
  "side_panel": { "default_path": "sidepanel.html" },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Sift — open side panel",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  }
}
